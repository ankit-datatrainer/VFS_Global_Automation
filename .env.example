# ==========================================
# VFS Slot Hunter — Configuration
# ==========================================
# Copy this file to .env and fill in your values
# NEVER commit your .env file to version control

# ---------- TELEGRAM BOT ----------
# Create a bot via @BotFather on Telegram
# Send /newbot, follow the prompts, get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram chat ID (send /start to @userinfobot to find it)
# For multiple recipients, comma-separate: 123456,789012
TELEGRAM_CHAT_IDS=your_chat_id_here

# ---------- VFS GLOBAL ACCOUNT ----------
# The VFS account used for MONITORING slot availability
# Recommend using a separate account, not the candidate's main one
VFS_EMAIL=your_vfs_email@example.com
VFS_PASSWORD=your_vfs_password_here

# ---------- TARGET CONFIGURATION ----------
# Which city to monitor: delhi, mumbai, bengaluru, chennai, kolkata, ahmedabad
TARGET_CITY=delhi

# Visa category
VISA_CATEGORY=national_visa

# ---------- MONITORING SETTINGS ----------
# Check interval in seconds (minimum 180 = 3 minutes, recommended 240-300)
CHECK_INTERVAL_MIN=180
CHECK_INTERVAL_MAX=300

# Enable quiet hours (reduced check frequency 1AM-5AM IST)
QUIET_HOURS_ENABLED=true

# ---------- ALERT SETTINGS ----------
# Enable/disable alert channels
ALERT_TELEGRAM=true
ALERT_DESKTOP=true
ALERT_SOUND=true

# ---------- ENCRYPTION ----------
# Master password for encrypting candidate data
# CHOOSE A STRONG PASSWORD — this protects passport numbers!
MASTER_PASSWORD=change_this_to_a_strong_password

# ---------- DASHBOARD ----------
# Dashboard port
DASHBOARD_PORT=3000

# ---------- CAPTCHA (Optional) ----------
# If you want automated CAPTCHA solving (costs ~₹2-5 per solve)
# Leave empty for semi-auto mode (you solve it manually)
CAPTCHA_API_KEY=
CAPTCHA_SERVICE=  # 2captcha or capsolver
