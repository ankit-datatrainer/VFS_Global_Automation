# ============================================================
#  Slot Relay configuration
# ============================================================
#  Copy to .env and fill in.
#
#  NOTE: there are deliberately NO VFS credentials here.
#  Slot Relay never logs into VFS, so it never needs them.
#  If you see VFS_EMAIL or VFS_PASSWORD in a .env file, that
#  belongs to different code — see README, "What is in this folder".
# ============================================================

# --- Telegram (optional but recommended) --------------------
# 1. Open Telegram, message @BotFather, send /newbot
# 2. Follow the prompts, copy the token it gives you
# 3. Paste it here
TELEGRAM_BOT_TOKEN=

# Your own chat id, for admin commands. Message @userinfobot to get it.
# Comma-separated if more than one.
TELEGRAM_ADMINS=

# --- Dashboard ----------------------------------------------
# 127.0.0.1 keeps it on this machine only. Change with care.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Shared secret for the "report a sighting" form. Leave blank while
# you are alone on this machine; set it if the dashboard is reachable
# by anyone else. Any random string is fine.
REPORT_TOKEN=

# --- Local alarm --------------------------------------------
# false disables the sound (alerts still go to Telegram)
ALARM_ENABLED=true
